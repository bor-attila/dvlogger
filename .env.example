AUTH_USER=admin
AUTH_PASSWORD=admin
LOG_FORMAT=auto            # text | json | gelf | auto
#LOG_TEXT_PATTERN=^(?<source>\S+) \[(?<tags>[^\]]*)\] ?(?<message>.*)$
ARCHIVE_ENABLED=true
RETENTION_DAYS=14
#INGEST_TOKEN=
BATCH_SIZE=500
BATCH_MS=200
REINDEX_ON_START=true
NO_FOOTER_TEXT=false       # true hides the "Vibed with Love" footer

# Host-side port mappings (container-internal ports stay 8080 / 11222). Default host port for the dashboard is 8086.
# Override if 8086 or 11222 are already taken on your machine.
#HTTP_PORT_HOST=8086
#INGEST_PORT_HOST=11222
